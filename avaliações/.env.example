# Variáveis de ambiente para os scripts de automação da pasta avaliações/
# Copie este arquivo para .env e preencha com seus dados reais.
# NUNCA commite o arquivo .env

# URL base da aplicação (ex: http://localhost:5173)
BASE_URL=http://localhost:5173

# Credenciais do usuário admin para os scripts de teste
ADMIN_EMAIL=seu_email_admin@exemplo.com
ADMIN_PASSWORD=sua_senha_admin
